# Copy this file to .env and fill in your values

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# EmailJS — https://emailjs.com (free, 200 emails/month)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_APPROVED=
VITE_EMAILJS_TEMPLATE_REJECTED=

# Super-admin email — any login with this email that has no Firestore role doc
# will be automatically bootstrapped as superAdmin on first login.
VITE_ADMIN_EMAIL=
